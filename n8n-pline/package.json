{
	"name": "n8n-nodes-pline",
	"version": "0.1.0",
	"description": "n8n community node for the Pline API: scrape pages, batch-scrape URL lists, crawl sites, map a site's URLs, and search the web.",
	"license": "MIT",
	"homepage": "https://github.com/grepsr/pline-api/tree/main/n8n-pline#readme",
	"keywords": [
		"n8n-community-node-package",
		"pline",
		"scraping",
		"crawling",
		"web-search",
		"data-extraction",
		"web-scraping"
	],
	"author": {
		"name": "Grepsr",
		"email": "dev@grepsr.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/grepsr/pline-api.git",
		"directory": "n8n-pline"
	},
	"bugs": {
		"url": "https://github.com/grepsr/pline-api/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "node test/smoke.js"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PlineApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Pline/Pline.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
