# Replace with the public HTTPS API base URL supplied by the service operator.
PLINE_BASE_URL=https://apix.pline.ai/v1
# Each user supplies their own API key. Never commit a real key.
PLINE_API_KEY=replace-with-your-api-key

# HTTP OAuth deployment only. Keep these unset for local stdio installs.
PLINE_PLATFORM_BASE_URL=https://app.pline.ai
PLINE_SUPABASE_URL=https://your-project.supabase.co
PLINE_MCP_PUBLIC_URL=https://mcp.prd.pline.ai
